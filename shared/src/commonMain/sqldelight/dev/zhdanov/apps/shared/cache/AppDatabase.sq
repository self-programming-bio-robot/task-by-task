import kotlin.Boolean;

CREATE TABLE IF NOT EXISTS FocusTime (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    duration INTEGER NOT NULL,
    feedback TEXT,
    finishedAt INTEGER NOT NULL,
    startedAt INTEGER,
    pauseTime INTEGER
);

insertFocusTime:
INSERT INTO FocusTime (duration, feedback, finishedAt, startedAt, pauseTime)
VALUES (?, ?, ?, ?, ?);

selectAllFocusTimes:
SELECT * FROM FocusTime;

selectFocusTimesInPeriod:
SELECT * FROM FocusTime
WHERE finishedAt BETWEEN ? AND ?;


CREATE TABLE IF NOT EXISTS DaySummary (
    date INTEGER NOT NULL,
    focusTime INTEGER NOT NULL,
    review TEXT NOT NULL
);

insertDaySummary:
INSERT INTO DaySummary (date, focusTime, review)
VALUES (?, ?, ?);

selectAllDaySummaries:
SELECT * FROM DaySummary
ORDER BY date DESC;

selectDaySummariesInPeriod:
SELECT * FROM DaySummary
WHERE date BETWEEN ? AND ?;

selectDaySummaryOnDate:
SELECT * FROM DaySummary
WHERE date = ?
LIMIT 1;


CREATE TABLE IF NOT EXISTS TimerSetting (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    workDuration INTEGER NOT NULL,
    shortBreakDuration INTEGER NOT NULL,
    longBreakDuration INTEGER NOT NULL,
    workCycles INTEGER NOT NULL,
    isDefault INTEGER AS Boolean NOT NULL DEFAULT 0
);

-- Insert a new TimerSetting
insertTimerSetting:
INSERT INTO TimerSetting (workDuration, shortBreakDuration, longBreakDuration, workCycles)
VALUES (?, ?, ?, ?);

-- Select all TimerSettings
selectAllTimerSettings:
SELECT * FROM TimerSetting;

-- Select a TimerSetting by id
selectTimerSettingById:
SELECT * FROM TimerSetting WHERE id = ?;

-- Update a TimerSetting
updateTimerSetting:
UPDATE TimerSetting
SET workDuration = ?, shortBreakDuration = ?, longBreakDuration = ?, workCycles = ?
WHERE id = ?;

-- Delete a TimerSetting by id
deleteTimerSettingById:
DELETE FROM TimerSetting WHERE id = ?;

-- Unset the current default TimerSetting
unsetDefaultTimerSetting:
UPDATE TimerSetting
SET isDefault = 0
WHERE isDefault = 1;

-- Set the default TimerSetting by id
setDefaultTimerSettingById:
UPDATE TimerSetting
SET isDefault = 1
WHERE id = ?;

-- Find default settings
findDefaultTimerSettings:
SELECT * FROM TimerSetting
WHERE isDefault = 1;


CREATE TABLE IF NOT EXISTS Settings (
    settingKey INTEGER NOT NULL PRIMARY KEY,
    data TEXT NOT NULL
);

insertOrReplaceSetting:
INSERT OR REPLACE INTO Settings(settingKey, data) VALUES (?, ?);

selectSetting:
SELECT * FROM Settings WHERE settingKey = ?;

deleteSetting:
DELETE FROM Settings WHERE settingKey = ?;

-- Tasks

CREATE TABLE IF NOT EXISTS Task (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT,
    createdAt INTEGER NOT NULL,
    completedAt INTEGER,
    isCompleted INTEGER AS Boolean NOT NULL DEFAULT 0,
    isToday INTEGER AS Boolean NOT NULL DEFAULT 0
);

insertTask:
INSERT INTO Task (title, description, isToday,createdAt)
VALUES (?, ?, ?, ?);

updateTaskCompletion:
UPDATE Task
SET isCompleted = ?, completedAt = ?
WHERE id = ?;

selectAllTasks:
SELECT * FROM Task
ORDER BY createdAt DESC;

selectTodayTasks:
SELECT * FROM Task
WHERE isToday = 1
ORDER BY createdAt DESC;

cleanTodayTaskList:
UPDATE Task
SET isToday = 0
WHERE isToday = 1;

updateTask:
UPDATE Task
SET title = ?, description = ?, isToday = ?
WHERE id = ?;

selectTaskById:
SELECT * FROM Task
WHERE id = ?;

deleteTask:
DELETE FROM Task WHERE id = ?;

-- COMMON
lastInsertRowId:
SELECT last_insert_rowid();
