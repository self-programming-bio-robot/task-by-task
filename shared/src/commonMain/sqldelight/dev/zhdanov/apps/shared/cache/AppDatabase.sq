import kotlin.Boolean;

CREATE TABLE IF NOT EXISTS Workspace (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    syncId TEXT NOT NULL UNIQUE,
    name TEXT NOT NULL,
    icon TEXT NOT NULL DEFAULT 'workspaces',
    isSelected INTEGER AS Boolean NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL,
    deletedAt INTEGER
);

insertWorkspace:
INSERT INTO Workspace(syncId, name, icon, isSelected, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?);

selectWorkspaces:
SELECT * FROM Workspace
WHERE deletedAt IS NULL
ORDER BY name ASC;

selectWorkspaceById:
SELECT * FROM Workspace
WHERE id = ? AND deletedAt IS NULL
LIMIT 1;

selectSelectedWorkspace:
SELECT * FROM Workspace
WHERE isSelected = 1 AND deletedAt IS NULL
LIMIT 1;

clearSelectedWorkspace:
UPDATE Workspace
SET isSelected = 0;

setSelectedWorkspace:
UPDATE Workspace
SET isSelected = 1, updatedAt = ?
WHERE id = ?;

updateWorkspaceName:
UPDATE Workspace
SET name = ?, updatedAt = ?
WHERE id = ?;

updateWorkspaceIcon:
UPDATE Workspace
SET icon = ?, updatedAt = ?
WHERE id = ?;

softDeleteWorkspace:
UPDATE Workspace
SET deletedAt = ?, updatedAt = ?, isSelected = 0
WHERE id = ?;

CREATE TABLE IF NOT EXISTS WorkspaceSecuritySettings (
    workspaceId INTEGER NOT NULL PRIMARY KEY,
    openAiToken TEXT NOT NULL DEFAULT '',
    llmBaseUrl TEXT NOT NULL DEFAULT 'https://api.openai.com/v1/',
    llmModelId TEXT NOT NULL DEFAULT 'gpt-4.1',
    encryptionEnabled INTEGER AS Boolean NOT NULL DEFAULT 0,
    encryptionSalt TEXT,
    wrappedDataKey TEXT,
    encryptionIterations INTEGER NOT NULL DEFAULT 600000,
    FOREIGN KEY(workspaceId) REFERENCES Workspace(id)
);

insertWorkspaceSecuritySettings:
INSERT OR IGNORE INTO WorkspaceSecuritySettings(
    workspaceId,
    openAiToken,
    llmBaseUrl,
    llmModelId,
    encryptionEnabled,
    encryptionSalt,
    wrappedDataKey,
    encryptionIterations
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectWorkspaceSecuritySettings:
SELECT * FROM WorkspaceSecuritySettings
WHERE workspaceId = ?;

updateWorkspaceAssistantConfig:
UPDATE WorkspaceSecuritySettings
SET openAiToken = ?, llmBaseUrl = ?, llmModelId = ?
WHERE workspaceId = ?;

updateWorkspaceEncryption:
UPDATE WorkspaceSecuritySettings
SET encryptionEnabled = ?, encryptionSalt = ?, wrappedDataKey = ?, encryptionIterations = ?
WHERE workspaceId = ?;

-- Focus sessions

CREATE TABLE IF NOT EXISTS FocusTime (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    duration INTEGER NOT NULL,
    feedback TEXT,
    finishedAt INTEGER NOT NULL,
    startedAt INTEGER,
    pauseTime INTEGER,
    taskId INTEGER,
    workspaceId INTEGER NOT NULL DEFAULT 1,
    syncId TEXT NOT NULL DEFAULT '',
    updatedAt INTEGER NOT NULL DEFAULT 0,
    deletedAt INTEGER,
    FOREIGN KEY(workspaceId) REFERENCES Workspace(id)
);

insertFocusTime:
INSERT INTO FocusTime (
    duration,
    feedback,
    finishedAt,
    startedAt,
    pauseTime,
    taskId,
    workspaceId,
    syncId,
    updatedAt
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateFocusTimeFeedback:
UPDATE FocusTime
SET feedback = ?, updatedAt = ?
WHERE workspaceId = ? AND id = ?;

selectAllFocusTimes:
SELECT * FROM FocusTime
WHERE workspaceId = ? AND deletedAt IS NULL;

selectFocusTimesInPeriod:
SELECT * FROM FocusTime
WHERE workspaceId = ? AND deletedAt IS NULL AND finishedAt BETWEEN ? AND ?;

CREATE TABLE IF NOT EXISTS DaySummary (
    date INTEGER NOT NULL,
    focusTime INTEGER NOT NULL,
    review TEXT NOT NULL,
    linkedTasks TEXT NOT NULL DEFAULT '[]',
    workspaceId INTEGER NOT NULL DEFAULT 1,
    syncId TEXT NOT NULL DEFAULT '',
    updatedAt INTEGER NOT NULL DEFAULT 0,
    deletedAt INTEGER,
    FOREIGN KEY(workspaceId) REFERENCES Workspace(id)
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_day_summary_workspace_date ON DaySummary(workspaceId, date);

deleteDaySummaryOnDate:
DELETE FROM DaySummary
WHERE workspaceId = ? AND date = ?;

insertDaySummary:
INSERT INTO DaySummary (
    date,
    focusTime,
    review,
    linkedTasks,
    workspaceId,
    syncId,
    updatedAt
)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateDaySummaryEncryptedFields:
UPDATE DaySummary
SET review = ?, linkedTasks = ?, updatedAt = ?
WHERE workspaceId = ? AND date = ?;

selectAllDaySummaries:
SELECT * FROM DaySummary
WHERE workspaceId = ? AND deletedAt IS NULL
ORDER BY date DESC;

selectDaySummariesInPeriod:
SELECT * FROM DaySummary
WHERE workspaceId = ? AND deletedAt IS NULL AND date BETWEEN ? AND ?;

selectDaySummaryOnDate:
SELECT * FROM DaySummary
WHERE workspaceId = ? AND deletedAt IS NULL AND date = ?
LIMIT 1;

CREATE TABLE IF NOT EXISTS TimerSetting (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    workDuration INTEGER NOT NULL,
    shortBreakDuration INTEGER NOT NULL,
    longBreakDuration INTEGER NOT NULL,
    workCycles INTEGER NOT NULL,
    isDefault INTEGER AS Boolean NOT NULL DEFAULT 0,
    workspaceId INTEGER NOT NULL DEFAULT 1,
    syncId TEXT NOT NULL DEFAULT '',
    updatedAt INTEGER NOT NULL DEFAULT 0,
    deletedAt INTEGER,
    FOREIGN KEY(workspaceId) REFERENCES Workspace(id)
);

insertTimerSetting:
INSERT INTO TimerSetting (
    workDuration,
    shortBreakDuration,
    longBreakDuration,
    workCycles,
    workspaceId,
    syncId,
    updatedAt
)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectAllTimerSettings:
SELECT * FROM TimerSetting
WHERE workspaceId = ? AND deletedAt IS NULL;

selectTimerSettingById:
SELECT * FROM TimerSetting
WHERE workspaceId = ? AND deletedAt IS NULL AND id = ?;

updateTimerSetting:
UPDATE TimerSetting
SET workDuration = ?, shortBreakDuration = ?, longBreakDuration = ?, workCycles = ?, updatedAt = ?
WHERE workspaceId = ? AND id = ?;

deleteTimerSettingById:
UPDATE TimerSetting
SET deletedAt = ?, updatedAt = ?
WHERE workspaceId = ? AND id = ?;

unsetDefaultTimerSetting:
UPDATE TimerSetting
SET isDefault = 0, updatedAt = ?
WHERE workspaceId = ? AND isDefault = 1;

setDefaultTimerSettingById:
UPDATE TimerSetting
SET isDefault = 1, updatedAt = ?
WHERE workspaceId = ? AND id = ?;

findDefaultTimerSettings:
SELECT * FROM TimerSetting
WHERE workspaceId = ? AND deletedAt IS NULL AND isDefault = 1;

CREATE TABLE IF NOT EXISTS Settings (
    settingKey INTEGER NOT NULL PRIMARY KEY,
    data TEXT NOT NULL
);

insertOrReplaceSetting:
INSERT OR REPLACE INTO Settings(settingKey, data) VALUES (?, ?);

selectSetting:
SELECT * FROM Settings WHERE settingKey = ?;

deleteSetting:
DELETE FROM Settings WHERE settingKey = ?;

-- Routines

CREATE TABLE IF NOT EXISTS Routine (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT,
    scheduleType TEXT NOT NULL DEFAULT 'DAILY',
    isActive INTEGER AS Boolean NOT NULL DEFAULT 1,
    workspaceId INTEGER NOT NULL DEFAULT 1,
    syncId TEXT NOT NULL DEFAULT '',
    createdAt INTEGER NOT NULL,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    deletedAt INTEGER,
    FOREIGN KEY(workspaceId) REFERENCES Workspace(id)
);

insertRoutine:
INSERT INTO Routine (
    title,
    description,
    scheduleType,
    isActive,
    createdAt,
    workspaceId,
    syncId,
    updatedAt
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectAllRoutines:
SELECT * FROM Routine
WHERE workspaceId = ? AND deletedAt IS NULL
ORDER BY createdAt DESC;

selectActiveRoutines:
SELECT * FROM Routine
WHERE workspaceId = ? AND deletedAt IS NULL AND isActive = 1
ORDER BY createdAt DESC;

selectRoutineById:
SELECT * FROM Routine
WHERE workspaceId = ? AND deletedAt IS NULL AND id = ?;

updateRoutine:
UPDATE Routine
SET title = ?, description = ?, scheduleType = ?, isActive = ?, updatedAt = ?
WHERE workspaceId = ? AND id = ?;

softDeleteRoutine:
UPDATE Routine
SET deletedAt = ?, updatedAt = ?
WHERE workspaceId = ? AND id = ?;

-- Tasks

CREATE TABLE IF NOT EXISTS Task (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT,
    createdAt INTEGER NOT NULL,
    completedAt INTEGER,
    isCompleted INTEGER AS Boolean NOT NULL DEFAULT 0,
    routineId INTEGER,
    targetDate INTEGER,
    workspaceId INTEGER NOT NULL DEFAULT 1,
    syncId TEXT NOT NULL DEFAULT '',
    updatedAt INTEGER NOT NULL DEFAULT 0,
    deletedAt INTEGER,
    FOREIGN KEY(workspaceId) REFERENCES Workspace(id)
);

CREATE INDEX IF NOT EXISTS idx_task_routine_date ON Task(workspaceId, routineId, targetDate);

insertTask:
INSERT INTO Task (
    title,
    description,
    targetDate,
    createdAt,
    workspaceId,
    syncId,
    updatedAt
)
VALUES (?, ?, ?, ?, ?, ?, ?);

insertTaskWithRoutine:
INSERT INTO Task (
    title,
    description,
    routineId,
    targetDate,
    createdAt,
    workspaceId,
    syncId,
    updatedAt
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateTaskCompletion:
UPDATE Task
SET isCompleted = ?, completedAt = ?, updatedAt = ?
WHERE workspaceId = ? AND id = ?;

selectAllTasks:
SELECT * FROM Task
WHERE workspaceId = ? AND deletedAt IS NULL
ORDER BY createdAt DESC;

updateTask:
UPDATE Task
SET title = ?, description = ?, targetDate = ?, updatedAt = ?
WHERE workspaceId = ? AND id = ?;

updateTaskEncryptedFields:
UPDATE Task
SET title = ?, description = ?, updatedAt = ?
WHERE workspaceId = ? AND id = ?;

selectTaskById:
SELECT * FROM Task
WHERE workspaceId = ? AND deletedAt IS NULL AND id = ?;

deleteTask:
UPDATE Task
SET deletedAt = ?, updatedAt = ?
WHERE workspaceId = ? AND id = ?;

updateTaskRoutine:
UPDATE Task
SET routineId = ?, targetDate = ?, updatedAt = ?
WHERE workspaceId = ? AND id = ?;

selectTaskByRoutineAndDate:
SELECT * FROM Task
WHERE workspaceId = ? AND deletedAt IS NULL AND routineId = ? AND targetDate = ?
LIMIT 1;

selectRoutineTasksInPeriod:
SELECT * FROM Task
WHERE workspaceId = ? AND deletedAt IS NULL AND routineId IS NOT NULL AND targetDate BETWEEN ? AND ?;

selectCompletedRoutineTasksUpToDate:
SELECT * FROM Task
WHERE workspaceId = ? AND deletedAt IS NULL AND routineId IS NOT NULL AND isCompleted = 1 AND targetDate <= ?;

selectCompletedTasksInPeriod:
SELECT * FROM Task
WHERE workspaceId = ? AND deletedAt IS NULL AND isCompleted = 1 AND completedAt BETWEEN ? AND ?
ORDER BY completedAt ASC;

-- FocusTime <-> Task Junction Table (Many-to-Many)

CREATE TABLE IF NOT EXISTS FocusTimeTaskCrossRef(
    focusTimeId INTEGER NOT NULL,
    taskId INTEGER NOT NULL,
    PRIMARY KEY(focusTimeId, taskId),
    FOREIGN KEY(focusTimeId) REFERENCES FocusTime(id),
    FOREIGN KEY(taskId) REFERENCES Task(id)
);

insertFocusTimeTaskCrossRef:
INSERT INTO FocusTimeTaskCrossRef (focusTimeId, taskId)
VALUES (?, ?);

selectTasksForFocusTime:
SELECT Task.id, Task.title, Task.description, Task.createdAt, Task.completedAt, Task.isCompleted, Task.routineId, Task.targetDate, Task.workspaceId, Task.syncId, Task.updatedAt, Task.deletedAt
FROM Task
INNER JOIN FocusTimeTaskCrossRef ON Task.id = FocusTimeTaskCrossRef.taskId
WHERE Task.workspaceId = ? AND Task.deletedAt IS NULL AND FocusTimeTaskCrossRef.focusTimeId = ?;

selectFocusTimesForTask:
SELECT FocusTime.id, FocusTime.duration, FocusTime.feedback, FocusTime.finishedAt, FocusTime.startedAt, FocusTime.pauseTime, FocusTime.taskId, FocusTime.workspaceId, FocusTime.syncId, FocusTime.updatedAt, FocusTime.deletedAt
FROM FocusTime
INNER JOIN FocusTimeTaskCrossRef ON FocusTime.id = FocusTimeTaskCrossRef.focusTimeId
WHERE FocusTime.workspaceId = ? AND FocusTime.deletedAt IS NULL AND FocusTimeTaskCrossRef.taskId = ?;

deleteFocusTimeTaskCrossRef:
DELETE FROM FocusTimeTaskCrossRef
WHERE focusTimeId = ? AND taskId = ?;

-- COMMON
lastInsertRowId:
SELECT last_insert_rowid();
